# The only required value. Neon connection string, pooled endpoint.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional. The agency's timezone, used for the date in the header.
# Vercel runs in UTC, so without this the page is a day behind the reader
# for most of their working evening. Defaults to America/New_York.
AGENCY_TZ=America/New_York
