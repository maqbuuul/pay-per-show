# Neon connection string.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Vercel Cron sends this as a bearer token to /api/cron/reset-demo.
CRON_SECRET=

# Shown on the sign-in page. Create the account first:
#   npm run create-user -- demo@example.com "Demo operator" <password> --demo
DEMO_EMAIL=
DEMO_PASSWORD=

# Timezone for activity times and invoice dates. Appointment times always use
# the clinic's own timezone.
AGENCY_TZ=America/New_York
